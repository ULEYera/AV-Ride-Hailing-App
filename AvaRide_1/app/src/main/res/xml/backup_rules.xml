<?xml version="1.0" encoding="utf-8"?>
<!--
    PB-11: Backup exclusions for local PII storage.

    user_secure_prefs.xml  — EncryptedSharedPreferences file (keys wrapped in Android Keystore;
                              the backing XML is safe but the Keystore key is device-bound,
                              so restoring the file to another device is useless — exclude anyway).
    datastore/             — Legacy plaintext DataStore directory (no longer written to, but may
                              still exist on devices that ran an older build).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="user_secure_prefs.xml" />
    <exclude domain="file" path="datastore" />
</full-backup-content>
