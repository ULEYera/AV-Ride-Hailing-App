<?xml version="1.0" encoding="utf-8"?>
<!--
    AvaRide HCE AID Configuration

    This file defines the Application IDs (AIDs) that the AvaRide HCE service
    will respond to. When a vehicle's NFC reader sends a SELECT command with
    our AID, Android routes the APDU to our AvaRideHceService.

    AID: F0415641524944
    - F0: Proprietary AID prefix (not registered with ISO)
    - 415641524944: "AVARID" in ASCII hex

    Category: "other" - Payment category requires additional certification
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_description"
    android:requireDeviceUnlock="true"
    android:apduServiceBanner="@drawable/ic_launcher_foreground">

    <aid-group
        android:description="@string/hce_aid_group_description"
        android:category="other">

        <!-- Primary AvaRide AID -->
        <aid-filter android:name="F0415641524944" />

        <!-- Alternative AID for testing -->
        <aid-filter android:name="F041564152" />

    </aid-group>

</host-apdu-service>

